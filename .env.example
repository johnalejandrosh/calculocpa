# Conexión a PostgreSQL. Copia este archivo a .env y completa los valores.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=innovacion
DB_USER=postgres
DB_PASSWORD=
# Esquema donde se crean las tablas de la app (también se acepta DB_SCHEMA).
DB_SHEMA=calculocpa
# Opcional: require | disable (por defecto lo decide el cliente de PostgreSQL).
# DB_SSLMODE=require
